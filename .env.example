# Local development (pnpm dev / pnpm test) — points at docker-compose.dev.yml's `db` service.
DATABASE_URI=postgres://archiv:archiv@localhost:5432/archiv
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Production compose (docker-compose.yml) only — DATABASE_URI is assembled from this by
# compose itself (postgres://archiv:${DB_PASSWORD}@db:5432/archiv), so it's not set directly.
# Generate with: openssl rand -base64 24
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
