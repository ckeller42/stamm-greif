{
  "name": "archiv",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "pnpm run test:unit && pnpm run test:int && pnpm run test:e2e",
    "test:unit": "vitest run tests/unit --coverage.enabled --coverage.include='src/lib/**'",
    "test:int": "scripts/fetch-face-models.sh && cross-env DATABASE_URI=postgres://archiv:archiv@localhost:5433/archiv_test vitest run tests/int --no-file-parallelism",
    "test:e2e": "playwright test",
    "faces:models": "scripts/fetch-face-models.sh"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/translations": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@react-pdf/renderer": "^4.9.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "exif-reader": "^2.0.3",
    "graphql": "^16.8.1",
    "next": "16.3.3",
    "onnxruntime-web": "1.29.0",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.5.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^11.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22",
    "pnpm": "^9 || ^10 || ^11"
  }
}
